# Salin ke .env lalu ganti semua nilai CHANGE_ME.
# Catatan: scripts\env.bat memuat file ini baris per baris -> JANGAN taruh komentar di akhir baris nilai.
# Generate secret: python -c "import secrets; print(secrets.token_urlsafe(48))"

# ---------- Gateway ----------
APP_ENV=dev
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO
LOG_DIR=./logs
TRUST_PROXY=false

DATABASE_URL=postgresql+asyncpg://llm_gateway:CHANGE_ME@127.0.0.1:5432/llm_gateway
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10

# minimal 32 karakter
GATEWAY_KEY_PEPPER=CHANGE_ME_LONG_RANDOM
DEFAULT_RPM_LIMIT=120
DEFAULT_TPM_LIMIT=200000
MAX_BODY_MB=20
# dipisah koma, mis. http://localhost:3000,http://127.0.0.1:5173
CORS_ORIGINS=
STORAGE_DIR=./storage
# retensi data (hari); usage_daily tidak pernah dihapus
REQUEST_RETENTION_DAYS=180
AUDIT_RETENTION_DAYS=730
RUNTIME_EVENT_RETENTION_DAYS=90

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# OpenRouter (provider custom, hanya model :free) - https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
# Opsional: admin key organisasi untuk biaya & usage AKTUAL di menu Usage konsol (hanya baca laporan)
OPENAI_ADMIN_KEY=
ANTHROPIC_ADMIN_KEY=

# ---------- Local Runtime ----------
RUNTIME_HOST=127.0.0.1
RUNTIME_PORT=8100
RUNTIME_URL=http://127.0.0.1:8100/v1
# minimal 32 karakter
RUNTIME_TOKEN=CHANGE_ME_RANDOM
MODELS_DIR=./local_models
OV_CACHE_DIR=./local_models/ov_cache
HF_HOME=./local_models/hf_cache

# Semua model lokal = OpenVINO di GPU/NPU. Pada iGPU/NPU Intel (UMA) memori GPU & NPU diambil
# dari RAM sistem yang sama: GPU+NPU budget harus menyisakan RAM untuk OS & layanan.
# Nilai untuk Core Ultra 5 225 / RAM 15,7 GB (docs/hardware.md): GPU 5300 MB (satu model 7B
# bergantian; reserve 700 = sisa pool plugin GPU setelah unload), NPU 6200 MB (SD + Coder-1.5B
# pinned). Total 11,5 GB → ±4,2 GB untuk OS, PostgreSQL, gateway.
GPU_TOTAL_MB=6000
GPU_RESERVE_MB=700
NPU_TOTAL_MB=6500
NPU_RESERVE_MB=300
# true hanya untuk dev/debug
ALLOW_CPU_FALLBACK=false
RUNTIME_QUEUE_TIMEOUT_S=30
RUNTIME_MIN_RESIDENCY_S=60
LOCAL_FIRST_TOKEN_TIMEOUT_S=120
# Whitelist runtime (alias, dipisah koma), diisi otomatis oleh `manage.py apply-profile`.
# Profil v1 remote-embed-gpu: hanya local/qwen3-embedding-0.6b. Kosong = semua model enabled.
RUNTIME_ALLOWED_MODELS=local/qwen3-embedding-0.6b
# Embedding X-Priority: bulk (LGW-V1-04/05): request bulk yang diproses bersamaan (sisanya antre
# FIFO, maks. timeout); interactive selalu menyela di antara batch bulk.
RUNTIME_BULK_CONCURRENCY=1
RUNTIME_BULK_QUEUE_TIMEOUT_S=300
