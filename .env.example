# Application
APP_NAME=LLM Gateway Marketing
DEBUG=False

# Server
HOST=127.0.0.1
PORT=5000
PUBLIC_URL=http://localhost:8080

# Database (PostgreSQL portable)
DATABASE_URL=postgresql+psycopg://postgres:PASSWORD@127.0.0.1:5432/llm_gateway

# Storage
STORAGE_PATH=./storages

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log

# Model Paths (folder model format OpenVINO)
QWEN_TEXT_MODEL_PATH=./models/qwen2.5-7b-instruct-ov
QWEN_CODER_MODEL_PATH=./models/qwen2.5-coder-7b-instruct-ov
QWEN_VISION_MODEL_PATH=./models/qwen2-vl-2b-instruct-ov
STABLE_DIFFUSION_MODEL_PATH=./models/stable-diffusion-v1-5-ov

# External APIs
OPENAI_API_KEY=sk-xxx
CLAUDE_API_KEY=sk-ant-xxx
GEMINI_API_KEY=xxx
